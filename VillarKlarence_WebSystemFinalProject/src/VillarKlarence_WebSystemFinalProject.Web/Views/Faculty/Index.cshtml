@{
    ViewData["Title"] = "Faculty Dashboard";
}
<div class="container-xxl py-4">
    <div class="page-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div>
            <p class="eyebrow mb-1">Faculty Dashboard</p>
            <h1 class="page-title mb-1">Grade Records</h1>
            <p class="text-body-secondary mb-0">
                Signed in as <strong data-user-name>…</strong>
                <span class="text-body-secondary" data-faculty-number></span>
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-primary" id="refreshButton">
                <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Refresh
            </button>
            <button type="button" class="btn btn-primary" id="addGradeButton">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add grade
            </button>
        </div>
    </div>

    @* Stat cards *@
    <section class="row g-3 mb-4 stagger" aria-label="Summary">
        <div class="col-6 col-lg-3">
            <div class="stat-card card-surface">
                <span class="stat-icon stat-icon-blue" aria-hidden="true"><i class="bi bi-journal-text"></i></span>
                <div>
                    <p class="stat-label">Total records</p>
                    <p class="stat-value" id="statTotal" data-skeleton>—</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card card-surface">
                <span class="stat-icon stat-icon-gold" aria-hidden="true"><i class="bi bi-people"></i></span>
                <div>
                    <p class="stat-label">Students</p>
                    <p class="stat-value" id="statStudents" data-skeleton>—</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card card-surface">
                <span class="stat-icon stat-icon-blue" aria-hidden="true"><i class="bi bi-book"></i></span>
                <div>
                    <p class="stat-label">Subjects</p>
                    <p class="stat-value" id="statSubjects" data-skeleton>—</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card card-surface">
                <span class="stat-icon stat-icon-success" aria-hidden="true"><i class="bi bi-graph-up-arrow"></i></span>
                <div>
                    <p class="stat-label">Pass rate</p>
                    <p class="stat-value" id="statPassRate" data-skeleton>—</p>
                </div>
            </div>
        </div>
    </section>

    @* Filters + table *@
    <section class="card-surface table-card" aria-labelledby="gradesHeading">
        <div class="table-toolbar">
            <h2 id="gradesHeading" class="h5 mb-0">All grade records</h2>
            <form class="row g-2 align-items-end filters" id="filterForm" role="search" aria-label="Filter grade records">
                <div class="col-12 col-md-4">
                    <label for="searchInput" class="form-label small mb-1">Search</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                        <input type="search" class="form-control" id="searchInput" placeholder="Student, number, subject, remark…" autocomplete="off" />
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <label for="semesterFilter" class="form-label small mb-1">Semester</label>
                    <select class="form-select" id="semesterFilter">
                        <option value="">All</option>
                        <option>1st Semester</option>
                        <option>2nd Semester</option>
                        <option>Summer</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label for="schoolYearFilter" class="form-label small mb-1">School year</label>
                    <select class="form-select" id="schoolYearFilter">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="col-8 col-md-3">
                    <label for="subjectFilter" class="form-label small mb-1">Subject</label>
                    <select class="form-select" id="subjectFilter">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="col-4 col-md-1 d-grid">
                    <button type="button" class="btn btn-outline-secondary" id="clearFilters" title="Clear filters">
                        <i class="bi bi-x-circle" aria-hidden="true"></i><span class="visually-hidden">Clear filters</span>
                    </button>
                </div>
            </form>
        </div>

        <div id="tableAlert" class="alert alert-danger mx-3 d-none" role="alert"></div>

        <div class="table-responsive">
            <table class="table table-hover align-middle grade-table mb-0" aria-describedby="resultSummary">
                <thead>
                    <tr>
                        <th scope="col" aria-sort="ascending"><button type="button" class="sort-btn" data-sort="studentNumber">Student <i class="bi" aria-hidden="true"></i></button></th>
                        <th scope="col" aria-sort="none"><button type="button" class="sort-btn" data-sort="subjectCode">Subject <i class="bi" aria-hidden="true"></i></button></th>
                        <th scope="col" class="text-end" aria-sort="none"><button type="button" class="sort-btn" data-sort="grade">Grade <i class="bi" aria-hidden="true"></i></button></th>
                        <th scope="col" aria-sort="none"><button type="button" class="sort-btn" data-sort="remarks">Remarks <i class="bi" aria-hidden="true"></i></button></th>
                        <th scope="col" aria-sort="none"><button type="button" class="sort-btn" data-sort="semester">Semester <i class="bi" aria-hidden="true"></i></button></th>
                        <th scope="col" aria-sort="none"><button type="button" class="sort-btn" data-sort="schoolYear">School year <i class="bi" aria-hidden="true"></i></button></th>
                        <th scope="col" class="d-none d-xl-table-cell" aria-sort="none"><button type="button" class="sort-btn" data-sort="facultyName">Faculty <i class="bi" aria-hidden="true"></i></button></th>
                        <th scope="col" class="d-none d-lg-table-cell" aria-sort="none"><button type="button" class="sort-btn" data-sort="datePosted">Posted <i class="bi" aria-hidden="true"></i></button></th>
                        <th scope="col" class="d-none d-lg-table-cell" aria-sort="none"><button type="button" class="sort-btn" data-sort="dateModified">Modified <i class="bi" aria-hidden="true"></i></button></th>
                        <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody id="gradeRows"></tbody>
            </table>
        </div>

        <div id="emptyState" class="empty-state d-none">
            <img src="~/images/logo.png" asp-append-version="true" alt="" width="72" height="72" />
            <h3 class="h5 mt-3" id="emptyTitle">No grade records found</h3>
            <p class="text-body-secondary mb-3" id="emptyText">Try a different search or clear the filters.</p>
        </div>

        <div class="table-footer">
            <p class="small text-body-secondary mb-0" id="resultSummary" aria-live="polite">Loading records…</p>
            <div class="d-flex align-items-center gap-2">
                <label for="pageSize" class="small text-body-secondary text-nowrap">Rows</label>
                <select id="pageSize" class="form-select form-select-sm w-auto">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <nav aria-label="Grade table pages">
                    <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
                </nav>
            </div>
        </div>
    </section>
</div>

@section Modals {
@* Add / Edit modal *@
<div class="modal fade" id="gradeModal" tabindex="-1" aria-labelledby="gradeModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form class="modal-content" id="gradeForm" novalidate>
            <div class="modal-header">
                <div>
                    <p class="eyebrow mb-0" id="gradeModalEyebrow">New record</p>
                    <h2 class="modal-title h4" id="gradeModalTitle">Add grade</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="formAlert" class="alert alert-danger d-none" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label for="studentId" class="form-label">Student <span class="text-danger" aria-hidden="true">*</span></label>
                        <select class="form-select" id="studentId" name="studentId" aria-describedby="studentIdFeedback" required>
                            <option value="">Loading students…</option>
                        </select>
                        <div class="invalid-feedback" id="studentIdFeedback"></div>
                    </div>
                    <div class="col-sm-4">
                        <label for="subjectCode" class="form-label">Subject code <span class="text-danger" aria-hidden="true">*</span></label>
                        <input type="text" class="form-control text-uppercase" id="subjectCode" name="subjectCode" list="subjectSuggestions"
                               maxlength="30" autocomplete="off" placeholder="e.g. WEB101" aria-describedby="subjectCodeFeedback subjectCodeHelp" required />
                        <datalist id="subjectSuggestions"></datalist>
                        <div class="form-text" id="subjectCodeHelp">Pick a suggestion or type a new code.</div>
                        <div class="invalid-feedback" id="subjectCodeFeedback"></div>
                    </div>
                    <div class="col-sm-8">
                        <label for="subjectName" class="form-label">Subject name <span class="text-danger" aria-hidden="true">*</span></label>
                        <input type="text" class="form-control" id="subjectName" name="subjectName" maxlength="200"
                               placeholder="e.g. Web Systems and Technologies" aria-describedby="subjectNameFeedback" required />
                        <div class="invalid-feedback" id="subjectNameFeedback"></div>
                    </div>
                    <div class="col-sm-4">
                        <label for="grade" class="form-label">Numerical grade <span class="text-danger" aria-hidden="true">*</span></label>
                        <input type="number" class="form-control" id="grade" name="grade" min="0" max="100" step="1" inputmode="numeric"
                               placeholder="0 – 100" aria-describedby="gradeFeedback gradeHelp" required />
                        <div class="form-text" id="gradeHelp">Whole number from 0 to 100.</div>
                        <div class="invalid-feedback" id="gradeFeedback"></div>
                    </div>
                    <div class="col-sm-4">
                        <label for="semester" class="form-label">Semester <span class="text-danger" aria-hidden="true">*</span></label>
                        <select class="form-select" id="semester" name="semester" aria-describedby="semesterFeedback" required>
                            <option value="1st Semester">1st Semester</option>
                            <option value="2nd Semester">2nd Semester</option>
                            <option value="Summer">Summer</option>
                        </select>
                        <div class="invalid-feedback" id="semesterFeedback"></div>
                    </div>
                    <div class="col-sm-4">
                        <label for="schoolYear" class="form-label">School year <span class="text-danger" aria-hidden="true">*</span></label>
                        <input type="text" class="form-control" id="schoolYear" name="schoolYear" maxlength="9" placeholder="2026-2027"
                               aria-describedby="schoolYearFeedback" required />
                        <div class="invalid-feedback" id="schoolYearFeedback"></div>
                    </div>
                </div>

                <div class="remarks-note mt-4">
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                    <span>
                        <strong>Remarks are computed by the server</strong> every time you save:
                        <span class="text-nowrap">95–100 <span class="remark-pill remark-cms">CMS</span></span>
                        <span class="text-nowrap">90–94 <span class="remark-pill remark-sp">SP</span></span>
                        <span class="text-nowrap">85–89 <span class="remark-pill remark-sap">SAP</span></span>
                        <span class="text-nowrap">80–84 <span class="remark-pill remark-gp">GP</span></span>
                        <span class="text-nowrap">75–79 <span class="remark-pill remark-ep">EP</span></span>
                        <span class="text-nowrap">0–74 <span class="remark-pill remark-failed">BEP/FAILED</span></span>
                    </span>
                </div>
                <p class="small text-body-secondary mt-3 mb-0 d-none" id="auditInfo"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="saveGradeButton">
                    <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Save grade
                </button>
            </div>
        </form>
    </div>
</div>

@* Delete confirmation modal *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h2 class="modal-title h5" id="deleteModalTitle"><i class="bi bi-exclamation-triangle text-danger me-2" aria-hidden="true"></i>Delete grade record?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">This permanently removes the following grade. This cannot be undone.</p>
                <dl class="delete-summary" id="deleteSummary"></dl>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep record</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteButton">
                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i>Delete permanently
                </button>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
    <script src="~/js/faculty-dashboard.js" asp-append-version="true"></script>
}
