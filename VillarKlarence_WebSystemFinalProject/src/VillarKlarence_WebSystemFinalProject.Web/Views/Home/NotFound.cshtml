@{
    ViewData["Title"] = "Page not found";
}
<section class="container-xxl py-5">
    <div class="status-card card-surface mx-auto text-center">
        <img src="~/images/logo.png" asp-append-version="true" alt="" width="96" height="96" class="status-logo mb-3" />
        <p class="status-code text-primary-emphasis" aria-hidden="true">404</p>
        <h1 class="h2">Page not found</h1>
        <p class="text-body-secondary mb-4">The page you are looking for does not exist or may have been moved.</p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a class="btn btn-primary" href="#" data-home-link><i class="bi bi-house-door me-1" aria-hidden="true"></i>Go to my dashboard</a>
            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Sign in</a>
        </div>
    </div>
</section>
