@{
    ViewData["Title"] = "Something went wrong";
    var code = ViewData["StatusCode"] as int? ?? 500;
    var requestId = ViewData["RequestId"] as string;
}
<section class="container-xxl py-5">
    <div class="status-card card-surface mx-auto text-center">
        <img src="~/images/logo.png" asp-append-version="true" alt="" width="96" height="96" class="status-logo mb-3" />
        <p class="status-code text-danger-emphasis" aria-hidden="true">@code</p>
        <h1 class="h2">Something went wrong</h1>
        <p class="text-body-secondary mb-4">We could not complete your request. Please try again in a moment.</p>
        @if (!string.IsNullOrEmpty(requestId))
        {
            <p class="small text-body-secondary">Reference: <code>@requestId</code></p>
        }
        <a class="btn btn-primary" asp-controller="Account" asp-action="Login"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to the portal</a>
    </div>
</section>
