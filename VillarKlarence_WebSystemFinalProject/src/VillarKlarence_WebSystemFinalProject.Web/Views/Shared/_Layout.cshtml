@inject IOptions<ApiSettings> ApiOptions
@{
    var hideNav = ViewData["HideNav"] is true;
    var pageTitle = ViewData["Title"] as string ?? "Grade Portal";
    var appConfig = new
    {
        apiBaseUrl = ApiOptions.Value.BaseUrl.TrimEnd('/'),
        urls = new
        {
            login = Url.Action("Login", "Account"),
            accessDenied = Url.Action("AccessDenied", "Account"),
            faculty = Url.Action("Index", "Faculty"),
            student = Url.Action("Index", "Student")
        }
    };
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="UST Angelicum College Student Grade Management System" />
    <meta name="color-scheme" content="light dark" />
    <title>@pageTitle • UST Angelicum College</title>

    @* Apply the saved theme before first paint to avoid a light/dark flash. *@
    <script>
        (function () {
            var theme = null;
            try { theme = window.localStorage.getItem('ac.theme'); } catch (e) { theme = null; }
            if (theme !== 'light' && theme !== 'dark') {
                theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>

    <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/logo.png" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" media="print" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(ViewData["BodyClass"] ?? "app-body")">
    <a class="skip-link" href="#main">Skip to main content</a>

    @* Splash screen: hidden by ui.js once the page is ready. *@
    <div id="splash" class="splash" role="status" aria-live="polite">
        <div class="splash-inner">
            <img src="~/images/logo.png" asp-append-version="true" alt="" class="splash-logo" width="112" height="112" />
            <p class="splash-title">UST Angelicum College</p>
            <p class="splash-sub">Student Grade Portal</p>
            <div class="splash-bar" aria-hidden="true"><span></span></div>
            <span class="visually-hidden">Loading…</span>
        </div>
    </div>

    @if (!hideNav)
    {
        <header>
            <nav class="navbar navbar-expand-md app-navbar" aria-label="Main navigation">
                <div class="container-xxl">
                    <a class="navbar-brand d-flex align-items-center gap-2" href="#" data-home-link>
                        <img src="~/images/logo.png" asp-append-version="true" alt="UST Angelicum College logo" width="44" height="44" class="brand-logo" />
                        <span class="brand-text">
                            <span class="brand-name">UST Angelicum College</span>
                            <span class="brand-sub">Student Grade Portal</span>
                        </span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                    <div class="collapse navbar-collapse justify-content-end" id="mainNav">
                        <div class="d-flex flex-column flex-md-row align-items-md-center gap-2 py-2 py-md-0">
                            <div class="user-chip" data-user-chip hidden>
                                <span class="user-avatar" data-user-initials aria-hidden="true">?</span>
                                <span class="user-meta">
                                    <span class="user-name" data-user-name></span>
                                    <span class="user-role" data-user-role></span>
                                </span>
                            </div>
                            <button type="button" class="btn btn-icon" data-theme-toggle aria-label="Switch to dark mode" title="Toggle light/dark mode">
                                <i class="bi bi-moon-stars" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="btn btn-outline-light btn-sm logout-btn" data-logout hidden>
                                <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Sign out
                            </button>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main id="main" class="app-main page-enter" tabindex="-1">
        @RenderBody()
    </main>

    @* Modals live outside <main>: its entrance animation creates a stacking context that would
       otherwise place Bootstrap's backdrop above the dialog. *@
    @await RenderSectionAsync("Modals", required: false)

    <footer class="app-footer">
        <div class="container-xxl d-flex flex-column flex-sm-row align-items-center justify-content-center gap-2 text-center">
            <img src="~/images/logo.png" asp-append-version="true" alt="" width="28" height="28" class="footer-logo" />
            <span>© 2026 UST Angelicum College • Caritas • Justitia • Fortitudo</span>
        </div>
    </footer>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastHost" aria-live="polite" aria-atomic="false"></div>

    <script>window.APP_CONFIG = @Json.Serialize(appConfig);</script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
